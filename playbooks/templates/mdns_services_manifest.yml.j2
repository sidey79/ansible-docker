---
# Generated by playbooks/import_mdns_services.yml from {{ inventory_hostname }}.
# Review all contents and set this to true before running playbooks/mdns.yml.
mdns_services_import_reviewed: false
# Kept disabled unless XML service files are explicitly in scope.
mdns_services_authoritative: false
mdns_services:
{{ mdns_import_services | default([]) | to_nice_yaml(indent=2) | indent(2, true) }}
avahi_alias_units:
{{ avahi_alias_units | default([]) | to_nice_yaml(indent=2) | indent(2, true) }}
mdns_services_import_report:
  imported_at_utc: "{{ now(utc=true, fmt='%Y-%m-%dT%H:%M:%SZ') }}"
  avahi_daemon_package:
{{ ansible_facts.packages['avahi-daemon'] | default([]) | to_nice_yaml(indent=2) | indent(4, true) }}
  avahi_daemon_service:
{{ ansible_facts.services['avahi-daemon.service'] | default({}) | to_nice_yaml(indent=2) | indent(4, true) }}
