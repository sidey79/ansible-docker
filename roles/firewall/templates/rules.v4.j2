*filter
#
# Delete all existing rules
-F
# Allow all loopback traffic
-A INPUT -i lo -j ACCEPT

# Allow all from trusted source
-A INPUT -s {{ firewall_trusted_source }} -j ACCEPT
#
# Basic rules

-P OUTPUT ACCEPT
-P INPUT   DROP
-P FORWARD DROP

# Accept all established connections
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow HTTP(S) connections
{% for port in firewall_http_ports %}
-A INPUT  -s {{ firewall_allowed_subnet }} -p tcp --dport {{ port }} -j ACCEPT
{% endfor %}

# Allow SMB
{% for port in firewall_smb_ports %}
-A INPUT -s {{ firewall_allowed_subnet }} -p tcp --dport {{ port }} -j ACCEPT
{% endfor %}

# Allow internal only SSH connections
-A INPUT -s {{ firewall_allowed_subnet }} -p tcp -m state --state NEW -m tcp --dport {{ firewall_ssh_port }} -j ACCEPT

# Allow ser2net connections
-A INPUT -s {{ firewall_allowed_subnet }} -p tcp -m multiport --dports {{ firewall_ser2net_ports | join(',') }} -j ACCEPT

# Allow ping

-A INPUT -p icmp -m icmp --icmp-type 8 -j ACCEPT

#

# Allow outgoing packages

-A OUTPUT -p ALL -j ACCEPT

#

# Reject all other inbound

-A INPUT -j REJECT --reject-with icmp-host-prohibited

-A FORWARD -j REJECT --reject-with icmp-host-prohibited

COMMIT
